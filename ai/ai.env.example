# Copy to ai\ai.env and fill in. ai.env is gitignored. Never commit real values.

# Folder that holds llama-server.exe (leave empty if it is on PATH)
LLAMA_DIR=C:\llama.cpp

# Qwen3-VL-8B-Instruct Q4_K_M and its vision projector (mmproj) file
MODEL_PATH=C:\models\Qwen3-VL-8B-Instruct-Q4_K_M.gguf
MMPROJ_PATH=C:\models\mmproj-Qwen3-VL-8B-Instruct-F16.gguf

# Local port. llama-server binds to 127.0.0.1 only; the tunnel reaches it.
AI_PORT=8081
# Layers on the GPU (99 = all). Lower it if you run out of VRAM (about 6 GB).
GPU_LAYERS=99
CTX_SIZE=4096

# Same value goes to AI_MODEL_KEY in the app (.env and Vercel)
AI_MODEL_KEY=change-me-long-random-string

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# In the dashboard, set the public hostname to http://localhost:8081
CF_TUNNEL_TOKEN=
